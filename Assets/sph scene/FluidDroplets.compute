// ============================================================
//  FluidBox.compute
//  محاكاة سائل مبسّطة (Clavet Double Density) داخل صندوق مستطيل
//  للعرض التوضيحي (Demo) - حركة السائل واستقراره
// ============================================================
#pragma kernel Integrate
#pragma kernel ClearGrid
#pragma kernel CountParticles
#pragma kernel PrefixSum
#pragma kernel ScatterParticles
#pragma kernel DoubleDensity
#pragma kernel ComputeVelocity
#pragma kernel MixColors

// --- المخازن (Buffers) ---
RWStructuredBuffer<float3> Positions;
RWStructuredBuffer<float3> Velocities;
RWStructuredBuffer<float3> PrevPositions;
RWStructuredBuffer<float4> Colors;       // لون كل جسيم (للاندماج)

// شبكة البحث عن الجيران (Spatial Hashing)
RWStructuredBuffer<uint> CellCounts;
RWStructuredBuffer<uint> CellStart;
RWStructuredBuffer<uint> CellEnd;
RWStructuredBuffer<uint> SortedIndices;
RWStructuredBuffer<uint> ParticleCellIndex;

// --- الثوابت (Constants) ---
uint  numParticles;
float deltaTime;
float gravity;
float smoothingRadius;
float restDensity;
float stiffness;
float nearStiffness;
float velocityDamping;

// حدود الصندوق (Box Bounds) بالعالم
float3 boxMin;
float3 boxMax;
float collisionDamping;

// حركة الاهتزاز (لزر الهزّ)
float3 shakeAccel;
// قوة خلط الألوان بين الجسيمات المتجاورة
float colorMixRate;

// الشبكة
float3 gridOrigin;
float  cellSize;
uint3  gridResolution;
uint   numCells;

// --- دوال مساعدة للشبكة ---
uint3 CellCoord(float3 pos)
{
    float3 local = (pos - gridOrigin) / cellSize;
    return (uint3)clamp(local, float3(0,0,0),
        float3(gridResolution.x-1, gridResolution.y-1, gridResolution.z-1));
}

uint CellHash(uint3 c)
{
    return c.x + c.y * gridResolution.x + c.z * gridResolution.x * gridResolution.y;
}

// ============================================================
//  1. دمج القوى (جاذبية + اهتزاز) وحفظ الموقع السابق
// ============================================================
[numthreads(256,1,1)]
void Integrate(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= numParticles) return;

    PrevPositions[id.x] = Positions[id.x];

    float3 accel = float3(0, -gravity, 0) + shakeAccel;
    Velocities[id.x] += accel * deltaTime;
    Velocities[id.x] *= velocityDamping;
    Positions[id.x] += Velocities[id.x] * deltaTime;
}

// ============================================================
//  2-5. بناء شبكة الجيران
// ============================================================
[numthreads(256,1,1)]
void ClearGrid(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= numCells) return;
    CellCounts[id.x] = 0;
    CellStart[id.x] = 0;
    CellEnd[id.x] = 0;
}

[numthreads(256,1,1)]
void CountParticles(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= numParticles) return;
    uint3 c = CellCoord(Positions[id.x]);
    uint h = CellHash(c);
    ParticleCellIndex[id.x] = h;
    InterlockedAdd(CellCounts[h], 1);
}

[numthreads(1,1,1)]
void PrefixSum(uint3 id : SV_DispatchThreadID)
{
    uint sum = 0;
    for (uint i = 0; i < numCells; i++)
    {
        CellStart[i] = sum;
        sum += CellCounts[i];
        CellEnd[i] = sum;
    }
}

[numthreads(256,1,1)]
void ScatterParticles(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= numParticles) return;
    uint h = ParticleCellIndex[id.x];
    uint idx;
    InterlockedAdd(CellStart[h], 1, idx);
    SortedIndices[idx] = id.x;
}

// ============================================================
//  6. الكثافة المزدوجة (Clavet) - قلب المحاكاة
// ============================================================
[numthreads(256,1,1)]
void DoubleDensity(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= numParticles) return;

    float3 pos = Positions[id.x];
    uint3 cc = CellCoord(pos);

    float density = 0;
    float nearDensity = 0;

    // مرور أول: حساب الكثافة من الجيران
    for (int dz = -1; dz <= 1; dz++)
    for (int dy = -1; dy <= 1; dy++)
    for (int dx = -1; dx <= 1; dx++)
    {
        int3 nc = int3(cc) + int3(dx, dy, dz);
        if (nc.x < 0 || nc.y < 0 || nc.z < 0) continue;
        if (nc.x >= (int)gridResolution.x || nc.y >= (int)gridResolution.y || nc.z >= (int)gridResolution.z) continue;

        uint h = CellHash((uint3)nc);
        uint start = CellEnd[h] - CellCounts[h];  // البداية الأصلية
        uint end = CellEnd[h];
        for (uint i = start; i < end; i++)
        {
            uint j = SortedIndices[i];
            if (j == id.x) continue;
            float3 diff = Positions[j] - pos;
            float dist = length(diff);
            float q = dist / smoothingRadius;
            if (q < 1.0)
            {
                float oneMinusQ = 1.0 - q;
                density += oneMinusQ * oneMinusQ;
                nearDensity += oneMinusQ * oneMinusQ * oneMinusQ;
            }
        }
    }

    // حساب الضغط
    float pressure = stiffness * (density - restDensity);
    float nearPressure = nearStiffness * nearDensity;

    // مرور ثاني: تطبيق الإزاحة على الجيران
    float3 posDelta = float3(0,0,0);
    for (int dz2 = -1; dz2 <= 1; dz2++)
    for (int dy2 = -1; dy2 <= 1; dy2++)
    for (int dx2 = -1; dx2 <= 1; dx2++)
    {
        int3 nc = int3(cc) + int3(dx2, dy2, dz2);
        if (nc.x < 0 || nc.y < 0 || nc.z < 0) continue;
        if (nc.x >= (int)gridResolution.x || nc.y >= (int)gridResolution.y || nc.z >= (int)gridResolution.z) continue;

        uint h = CellHash((uint3)nc);
        uint start = CellEnd[h] - CellCounts[h];
        uint end = CellEnd[h];
        for (uint i = start; i < end; i++)
        {
            uint j = SortedIndices[i];
            if (j == id.x) continue;
            float3 diff = Positions[j] - pos;
            float dist = length(diff);
            float q = dist / smoothingRadius;
            if (q < 1.0 && dist > 0.0001)
            {
                float oneMinusQ = 1.0 - q;
                float displaceMag = (pressure * oneMinusQ + nearPressure * oneMinusQ * oneMinusQ) * deltaTime * deltaTime;
                float3 dir = diff / dist;
                posDelta -= dir * displaceMag * 0.5;
            }
        }
    }

    Positions[id.x] += posDelta;

    // حدود الصندوق: ارتداد بسيط
    float3 p = Positions[id.x];
    if (p.x < boxMin.x) { p.x = boxMin.x; Velocities[id.x].x *= -collisionDamping; }
    if (p.x > boxMax.x) { p.x = boxMax.x; Velocities[id.x].x *= -collisionDamping; }
    if (p.y < boxMin.y) { p.y = boxMin.y; Velocities[id.x].y *= -collisionDamping; }
    if (p.y > boxMax.y) { p.y = boxMax.y; Velocities[id.x].y *= -collisionDamping; }
    if (p.z < boxMin.z) { p.z = boxMin.z; Velocities[id.x].z *= -collisionDamping; }
    if (p.z > boxMax.z) { p.z = boxMax.z; Velocities[id.x].z *= -collisionDamping; }
    Positions[id.x] = p;
}

// ============================================================
//  7. تحديث السرعة من تغيّر الموقع (يلتقط تصحيح الكثافة)
// ============================================================
[numthreads(256,1,1)]
void ComputeVelocity(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= numParticles) return;
    if (deltaTime > 0)
        Velocities[id.x] = (Positions[id.x] - PrevPositions[id.x]) / deltaTime;
}

// ============================================================
//  8. خلط الألوان: الجسيمات المتجاورة تمزج ألوانها تدريجياً
//     (اندماج القطرات: أحمر + أزرق => بنفسجي)
// ============================================================
[numthreads(256,1,1)]
void MixColors(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= numParticles) return;

    float3 pos = Positions[id.x];
    float4 myColor = Colors[id.x];
    uint3 cc = CellCoord(pos);

    float4 colorSum = float4(0,0,0,0);
    float weightSum = 0;

    // اجمع ألوان الجيران القريبين (موزونة بالقرب)
    for (int dz = -1; dz <= 1; dz++)
    for (int dy = -1; dy <= 1; dy++)
    for (int dx = -1; dx <= 1; dx++)
    {
        int3 nc = int3(cc) + int3(dx, dy, dz);
        if (nc.x < 0 || nc.y < 0 || nc.z < 0) continue;
        if (nc.x >= (int)gridResolution.x || nc.y >= (int)gridResolution.y || nc.z >= (int)gridResolution.z) continue;

        uint h = CellHash((uint3)nc);
        uint start = CellEnd[h] - CellCounts[h];
        uint end = CellEnd[h];
        for (uint i = start; i < end; i++)
        {
            uint j = SortedIndices[i];
            if (j == id.x) continue;
            float dist = length(Positions[j] - pos);
            float q = dist / smoothingRadius;
            if (q < 1.0)
            {
                float w = 1.0 - q;
                colorSum += Colors[j] * w;
                weightSum += w;
            }
        }
    }

    if (weightSum > 0.0001)
    {
        float4 avgNeighbor = colorSum / weightSum;
        // امزج لوني نحو متوسط الجيران بمعدّل بطيء (اندماج تدريجي)
        Colors[id.x] = lerp(myColor, avgNeighbor, colorMixRate * deltaTime);
    }
}
