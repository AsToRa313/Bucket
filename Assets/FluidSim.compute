// ============================================================
//  FluidSim.compute  —  مع نظام SpatialHash
//  تم إصلاح خطأ الـ Infinite Loop الذي كان يعلق الكرت بالكامل
// ============================================================

#pragma kernel ApplyGravity
#pragma kernel UpdateSpatialHash
#pragma kernel ReorderData_PosVel
#pragma kernel ReorderData_StateColor
#pragma kernel ReorderCopyBack_PosVel
#pragma kernel ReorderCopyBack_StateColor
#pragma kernel DoubleDensityRelax
#pragma kernel ComputeVelocity
#pragma kernel CheckHoles
#pragma kernel ApplyVortex
#pragma kernel PaintOnCanvas

RWStructuredBuffer<float3> Positions;
RWStructuredBuffer<float3> PrevPositions;
RWStructuredBuffer<float3> Velocities;
RWStructuredBuffer<uint> States;

RWStructuredBuffer<uint3> SpatialKeys;
RWStructuredBuffer<uint> SpatialOffsets;
RWStructuredBuffer<uint> SortedIndices;

RWStructuredBuffer<float3> SortedPositions;
RWStructuredBuffer<float3> SortedPrevPositions;
RWStructuredBuffer<float3> SortedVelocities;
RWStructuredBuffer<uint> SortedStates;
RWStructuredBuffer<float4> ParticleColorsSorted;
RWStructuredBuffer<float4> ParticleColorsIn;

StructuredBuffer<float4> Holes;
const uint numHoles;
const float vortexRange, vortexPull, vortexSpin;

const float canvasY;
const float3 canvasCenter;
const float2 canvasHalfSize;
const uint canvasEnabled;
AppendStructuredBuffer<float3> SplatPoints;
RWTexture2D<float4> CanvasTex;
RWStructuredBuffer<float> CanvasAccum;
RWStructuredBuffer<float4> ParticleColors;
const uint canvasResolution;
const float4 paintColorGPU;
const float splatRadiusPixels, paintOpacityGPU;
const uint canvasFlipU, canvasFlipV, canvasPooling;
const float poolGrowth;
const uint canvasWetMix;
const float wetMixStrength;

const uint numParticles;
const float deltaTime, gravity, smoothingRadius;
const float restDensity, stiffness, nearStiffness, velocityDamping;
const float3 bucketCenter;
const float4 bucketRotation;
const float bucketRadius, bucketHeight, collisionDamping, wallRestitution;
const float3 externalAccel;

const uint HashK1 = 15823;
const uint HashK2 = 9737333;
const uint HashK3 = 440817757;

int3 CellCoord(float3 pos)
{
    return (int3) floor(pos / smoothingRadius);
}

uint HashCell(int3 cell)
{
    uint a = (uint) (cell.x * HashK1);
    uint b = (uint) (cell.y * HashK2);
    uint c = (uint) (cell.z * HashK3);
    return a + b + c;
}

uint KeyFromHash(uint hash, uint tableSize)
{
    return hash % tableSize;
}

float3 QuatRotate(float4 q, float3 v)
{
    float3 u = float3(q.x, q.y, q.z);
    float s = q.w;
    return 2.0 * dot(u, v) * u + (s * s - dot(u, u)) * v + 2.0 * s * cross(u, v);
}
float4 QuatInverse(float4 q)
{
    return float4(-q.x, -q.y, -q.z, q.w);
}


[numthreads(256, 1, 1)]
void ApplyGravity(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= numParticles)
        return;

    if (States[id.x] >= 2)
    {
        Velocities[id.x] = float3(0, 0, 0);
        return;
    }

    float3 accel = float3(0, -gravity, 0);
    if (States[id.x] == 0)
        accel += externalAccel;

    Velocities[id.x] += accel * deltaTime;
    PrevPositions[id.x] = Positions[id.x];
    Positions[id.x] += Velocities[id.x] * deltaTime;
}


[numthreads(256, 1, 1)]
void UpdateSpatialHash(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= numParticles)
        return;
    int3 cell = CellCoord(Positions[id.x]);
    uint hash = HashCell(cell);
    uint key = KeyFromHash(hash, numParticles);
    SpatialKeys[id.x] = uint3(id.x, key, 0);
}

[numthreads(256, 1, 1)]
void ReorderData_PosVel(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= numParticles)
        return;
    uint src = SortedIndices[id.x];
    SortedPositions[id.x] = Positions[src];
    SortedPrevPositions[id.x] = PrevPositions[src];
    SortedVelocities[id.x] = Velocities[src];
}

[numthreads(256, 1, 1)]
void ReorderData_StateColor(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= numParticles)
        return;
    uint src = SortedIndices[id.x];
    SortedStates[id.x] = States[src];
    ParticleColorsSorted[id.x] = ParticleColorsIn[src];
}

[numthreads(256, 1, 1)]
void ReorderCopyBack_PosVel(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= numParticles)
        return;
    Positions[id.x] = SortedPositions[id.x];
    PrevPositions[id.x] = SortedPrevPositions[id.x];
    Velocities[id.x] = SortedVelocities[id.x];
}

[numthreads(256, 1, 1)]
void ReorderCopyBack_StateColor(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= numParticles)
        return;
    States[id.x] = SortedStates[id.x];
    ParticleColorsIn[id.x] = ParticleColorsSorted[id.x];
}


[numthreads(256, 1, 1)]
void DoubleDensityRelax(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= numParticles)
        return;
    if (States[id.x] == 1)
        return;

    float3 pos = Positions[id.x];
    int3 baseCell = CellCoord(pos);
    float h = smoothingRadius;
    float h2 = h * h;

    float density = 0;
    float nearDensity = 0;

    // --- تمريرة 1: الكثافة ---
   // --- تمريرة 1: الكثافة ---
    for (int ox = -1; ox <= 1; ox++)
        for (int oy = -1; oy <= 1; oy++)
            for (int oz = -1; oz <= 1; oz++)
            {
                int3 cell = baseCell + int3(ox, oy, oz);
                uint key = KeyFromHash(HashCell(cell), numParticles);
                uint startIdx = SpatialOffsets[key];

                int neighborCount = 0; // <--- صمام الأمان

                for (uint i = startIdx; i < numParticles; i++)
                {
                    uint originalIdx = SortedIndices[i];
                    if (SpatialKeys[originalIdx].y != key)
                        break;

                    uint j = i;
                    if (j == id.x || States[j] == 1)
                        continue;

        // <--- حماية كرت الشاشة: لا تفحص أكثر من 64 جار في الخلية الواحدة
                    if (neighborCount++ > 64)
                        break;

                    float3 diff = Positions[j] - pos;
                    float r2 = dot(diff, diff);
                    if (r2 < h2 && r2 > 0)
                    {
                        float r = sqrt(r2);
                        float q = 1.0 - r / h;
                        density += q * q;
                        nearDensity += q * q * q;
                    }
                }
            }

    float pressure = stiffness * (density - restDensity);
    float nearPressure = nearStiffness * nearDensity;

    // --- تمريرة 2: الإزاحات ---
    float3 dispSelf = 0;
    for (int ox2 = -1; ox2 <= 1; ox2++)
        for (int oy2 = -1; oy2 <= 1; oy2++)
            for (int oz2 = -1; oz2 <= 1; oz2++)
            {
                int3 cell = baseCell + int3(ox2, oy2, oz2);
                uint key = KeyFromHash(HashCell(cell), numParticles);
                uint startIdx = SpatialOffsets[key];
                int neighborCount = 0; // <--- صمام الأمان هنا أيضاً

                for (uint i = startIdx; i < numParticles; i++)
                {
                    uint originalIdx = SortedIndices[i];
                    if (SpatialKeys[originalIdx].y != key)
                        break;

                    uint j = i;
                    if (j == id.x || States[j] == 1)
                        continue;

                    if (neighborCount++ > 64)
                        break;

                    float3 diff = Positions[j] - pos;
                    float r2 = dot(diff, diff);
                    if (r2 < h2 && r2 > 0)
                    {
                        float r = sqrt(r2);
                        float q = 1.0 - r / h;
                        float3 dir = diff / r;
                        float mag = (pressure * q + nearPressure * q * q) * deltaTime * deltaTime * 0.5;
                        dispSelf -= dir * mag;
                    }
                }
            }
// --- حماية ضد الانفجار: منع الجسيم من القفز لمسافة جنونية في فريم واحد ---
    float maxDisp = smoothingRadius * 0.5; // أقصى مسافة مسموحة للإزاحة
    float dispLength = length(dispSelf);
    if (dispLength > maxDisp)
    {
        dispSelf = (dispSelf / dispLength) * maxDisp;
    }

    Positions[id.x] = pos + dispSelf;
}


[numthreads(256, 1, 1)]
void ComputeVelocity(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= numParticles)
        return;

    if (States[id.x] == 2 || States[id.x] == 4)
    {
        Velocities[id.x] = float3(0, 0, 0);
        Positions[id.x] = float3(9999, 9999, 9999);
        return;
    }
    if (States[id.x] == 3)
    {
        Velocities[id.x] = float3(0, 0, 0);
        return;
    }

    float3 newPos = Positions[id.x];
    if (deltaTime > 0)
        Velocities[id.x] = (newPos - PrevPositions[id.x]) / deltaTime;

    Velocities[id.x] *= velocityDamping;

    if (States[id.x] == 1)
    {
        float prevY = PrevPositions[id.x].y;
        if (canvasEnabled == 1 && newPos.y <= canvasY)
        {
            float dx = abs(newPos.x - canvasCenter.x);
            float dz = abs(newPos.z - canvasCenter.z);
            if (dx <= canvasHalfSize.x && dz <= canvasHalfSize.y)
            {
                float3 splatPos = float3(newPos.x, canvasY, newPos.z);
                Positions[id.x] = splatPos;
                Velocities[id.x] = float3(0, 0, 0);
                States[id.x] = 3;
                SplatPoints.Append(splatPos);
            }
        }
        return;
    }

    float4 invRot = QuatInverse(bucketRotation);
    float3 local = QuatRotate(invRot, newPos - bucketCenter);
    float3 localVel = QuatRotate(invRot, Velocities[id.x]);

    float bottomY = -bucketHeight * 0.5;
    bool changed = false;

    if (local.y < bottomY)
    {
        local.y = bottomY;
        localVel.y = abs(localVel.y) * wallRestitution;
        changed = true;
    }
    float2 xz = float2(local.x, local.z);

    float radial = length(xz);
    if (radial > bucketRadius)
    {
        float2 n = xz / radial;
        local.x = n.x * bucketRadius;
        local.z = n.y * bucketRadius;
        float2 vxz = float2(localVel.x, localVel.z);
        float vn = dot(vxz, n);
        if (vn > 0)
        {
            vxz -= n * vn * (1.0 + wallRestitution);
            localVel.x = vxz.x;
            localVel.z = vxz.y;
        }
        changed = true;
    }

    if (changed)
    {
        Positions[id.x] = bucketCenter + QuatRotate(bucketRotation, local);
        Velocities[id.x] = QuatRotate(bucketRotation, localVel);
    }
}


[numthreads(256, 1, 1)]
void CheckHoles(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= numParticles)
        return;
    if (States[id.x] == 1)
        return;

    float4 invRot = QuatInverse(bucketRotation);
    float3 local = QuatRotate(invRot, Positions[id.x] - bucketCenter);
    float topY = bucketHeight * 0.5;

    if (local.y > topY + smoothingRadius)
    {
        States[id.x] = 1;
        return;
    }

    for (uint hi = 0; hi < numHoles; hi++)
    {
        float4 hole = Holes[hi];
        float d = length(local - hole.xyz);
        if (d < hole.w)
        {
            States[id.x] = 1;
            Velocities[id.x] = float3(0, -0.5, 0);
            return;
        }
    }
}


[numthreads(256, 1, 1)]
void ApplyVortex(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= numParticles)
        return;
    if (States[id.x] == 1)
        return;

    float4 invRot = QuatInverse(bucketRotation);
    float3 local = QuatRotate(invRot, Positions[id.x] - bucketCenter);
    float3 localVel = QuatRotate(invRot, Velocities[id.x]);
    bool affected = false;

    for (uint hi = 0; hi < numHoles; hi++)
    {
        float4 hole = Holes[hi];
        float range = hole.w * vortexRange;
        float3 toHole = hole.xyz - local;
        float dist = length(toHole);

        if (dist < range && dist > 0.0001)
        {
            float3 axis = normalize(hole.xyz);
            if (length(hole.xyz) < 0.0001)
                axis = float3(0, 1, 0);
            float3 radialDir = toHole / dist;
            
            float strength = 1.0 - (dist / range);
            strength = strength * strength;

            localVel += radialDir * vortexPull * strength * deltaTime;
            float3 tangent = cross(axis, radialDir);
            localVel += tangent * vortexSpin * strength * deltaTime;
            affected = true;
        }
    }

    if (affected)
        Velocities[id.x] = QuatRotate(bucketRotation, localVel);
}


[numthreads(256, 1, 1)]
void PaintOnCanvas(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= numParticles)
        return;
    if (States[id.x] != 3)
        return;

    float3 pos = Positions[id.x];
    float4 dropColor = ParticleColors[id.x];

    float u = (pos.x - canvasCenter.x) / (canvasHalfSize.x * 2.0) + 0.5;
    float v = (pos.z - canvasCenter.z) / (canvasHalfSize.y * 2.0) + 0.5;

    if (canvasFlipV == 1)
        v = 1.0 - v;
    if (canvasFlipU == 1)
        u = 1.0 - u;

    if (u < 0.0 || u > 1.0 || v < 0.0 || v > 1.0)
    {
        States[id.x] = 4;
        return;
    }

    int cx = (int) (u * canvasResolution);
    int cy = (int) (v * canvasResolution);
    int r = max(1, (int) splatRadiusPixels);
    int coreRadius = r;
    int outerRadius = coreRadius;

    if (canvasPooling == 1)
    {
        int centerIdx = clamp(cy, 0, (int) canvasResolution - 1) * (int) canvasResolution + clamp(cx, 0, (int) canvasResolution - 1);
        CanvasAccum[centerIdx] += 1.0;
        float growth = log2(1.0 + CanvasAccum[centerIdx]) * poolGrowth;
        // أضفت حماية هنا لمنع توسع البركة بشكل يعلق الكرت (حد أقصى 48 بكسل كحلقة)
        outerRadius = min((int) (coreRadius * (1.0 + growth)), 48);
    }

    for (int dy = -outerRadius; dy <= outerRadius; dy++)
    {
        for (int dx = -outerRadius; dx <= outerRadius; dx++)
        {
            int px = cx + dx;
            int py = cy + dy;
            if (px < 0 || px >= (int) canvasResolution || py < 0 || py >= (int) canvasResolution)
                continue;

            float dist = sqrt((float) (dx * dx + dy * dy));
            float outerFalloff = smoothstep(0.0, 1.0, 1.0 - saturate(dist / (float) outerRadius));
            if (outerFalloff <= 0.001)
                continue;

            bool inCore = dist <= (float) coreRadius;
            float coreFalloff = inCore ? smoothstep(0.0, 1.0, 1.0 - saturate(dist / (float) coreRadius)) : 0.0;
            float alpha = inCore ? ((coreFalloff > 0.8) ? coreFalloff : paintOpacityGPU * coreFalloff) : paintOpacityGPU * outerFalloff * 0.5;

            uint2 coord = uint2((uint) px, (uint) py);
            float4 existing = CanvasTex[coord];

            float colorDiff = distance(existing.rgb, dropColor.rgb);
            bool hasPaint = existing.a > 0.05;

            float4 result;
            if (hasPaint && colorDiff > 0.1 && canvasWetMix == 1)
            {
                float3 mixed = lerp((existing.rgb + dropColor.rgb) * 0.5, existing.rgb * dropColor.rgb, wetMixStrength);
                result.rgb = lerp(existing.rgb, mixed, alpha);
                result.a = max(existing.a, alpha);
            }
            else
            {
                result = lerp(existing, dropColor, alpha);
                result.a = max(existing.a, alpha);
            }
            CanvasTex[coord] = result;
        }
    }
    States[id.x] = 4;
}