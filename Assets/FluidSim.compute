// ============================================================
//  FluidSim.compute  —  النسخة 2 (صيغة Clavet النظيفة)
//  محاكاة سوائل تفاعلية على GPU
//  Double-Density Relaxation (Clavet et al. 2005)
//
//  ترتيب الاستدعاء كل خطوة:
//    1. ApplyGravity        (جاذبية + قصور + حفظ الموقع السابق + تحريك)
//    2. BuildSpatialHash    (clear → count → prefix → scatter)
//    3. DoubleDensityRelax  (كثافة مزدوجة + إزاحة مواقع)
//    4. ComputeVelocity     (السرعة = (الموقع - السابق)/dt) + حدود + لزوجة
// ============================================================

#pragma kernel ApplyGravity
#pragma kernel ClearGrid
#pragma kernel CountParticles
#pragma kernel PrefixScanBlocks
#pragma kernel PrefixScanBlockSums
#pragma kernel PrefixScanCombine
#pragma kernel ScatterParticles
#pragma kernel ReorderData_PosVel
#pragma kernel ReorderData_StateColor
#pragma kernel ReorderCopyBack_PosVel
#pragma kernel ReorderCopyBack_StateColor
#pragma kernel DoubleDensityRelax
#pragma kernel ComputeVelocity
#pragma kernel CheckHoles
#pragma kernel ApplyVortex
#pragma kernel PaintOnCanvas

// ------------------------------------------------------------
//  البفرز الرئيسية
// ------------------------------------------------------------
RWStructuredBuffer<float3> Positions;       // المواقع الحالية
RWStructuredBuffer<float3> PrevPositions;    // المواقع قبل الخطوة (لحساب السرعة)
RWStructuredBuffer<float3> Velocities;       // السرعات
RWStructuredBuffer<uint>   States;           // 0 = داخل السطل، 1 = قطرة حرة

// buffers الهدف لإعادة الترتيب (Reorder) - الجيران يصيروا متجاورين بالذاكرة
RWStructuredBuffer<float3> SortedPositions;
RWStructuredBuffer<float3> SortedPrevPositions;
RWStructuredBuffer<float3> SortedVelocities;
RWStructuredBuffer<uint>   SortedStates;
RWStructuredBuffer<float4> ParticleColorsSorted;
RWStructuredBuffer<float4> ParticleColorsIn;   // ألوان المصدر (للترتيب)

// الثقوب: كل ثقب = float4(موقع محلي xyz، نصف القطر w)
StructuredBuffer<float4> Holes;
const uint numHoles;

// قوى الدوامة حول الثقوب
const float vortexRange;     // نطاق تأثير الدوامة حول الثقب (مضاعف لنصف القطر)
const float vortexPull;      // قوة الجذب الشعاعي نحو الثقب
const float vortexSpin;      // قوة الدوران (الالتفاف) حول محور الثقب

// اللوحة: كشف وصول القطرات (للرسم)
const float canvasY;          // مستوى ارتفاع اللوحة بالعالم
const float3 canvasCenter;    // مركز اللوحة بالعالم
const float2 canvasHalfSize;  // نصف أبعاد اللوحة (X,Z)
const uint  canvasEnabled;    // 1 = الكشف مفعّل

// مواقع القطرات الواصلة للوحة (يكتبها الـ compute، يقرأها المدير للرسم)
AppendStructuredBuffer<float3> SplatPoints;

// تكستشر اللوحة القابل للكتابة (الرسم مباشرة على GPU - صفر تأخير)
RWTexture2D<float4> CanvasTex;
// تراكم الدهان لكل بكسل (يزيد مع كل بقعة => توسّع بلا سقف)
RWStructuredBuffer<float> CanvasAccum;
// لون كل جسيم (لدعم ألوان متعددة على الكانفاس)
RWStructuredBuffer<float4> ParticleColors;
const uint  canvasResolution;   // دقة التكستشر (بكسل)
const float4 paintColorGPU;     // لون الدهان
const float splatRadiusPixels;  // نصف قطر البقعة بالبكسل
const float paintOpacityGPU;    // شفافية الدهان
const uint  canvasFlipU;        // قلب المحور الأفقي (0/1)
const uint  canvasFlipV;        // قلب المحور العمودي (0/1)
const uint  canvasPooling;      // تفعيل توسّع البقعة عند التراكم (0/1)
const float poolGrowth;         // معامل نمو البقعة عند التشبّع
const uint  canvasWetMix;       // تفعيل خلط الألوان الرطب (0/1)
const float wetMixStrength;     // قوة الخلط الطرحي (0=متوسط، 1=طرحي كامل)

// التجزئة المكانية
RWStructuredBuffer<uint> CellCounts;
RWStructuredBuffer<uint> CellStart;
RWStructuredBuffer<uint> CellEnd;
RWStructuredBuffer<uint> SortedIndices;
RWStructuredBuffer<uint> ParticleCellIndex;
RWStructuredBuffer<uint> BlockSums;   // مجاميع الكتل لـ prefix sum المتوازي

// ------------------------------------------------------------
//  الثوابت (من C#)
// ------------------------------------------------------------
const uint  numParticles;
const float deltaTime;
const float gravity;
const float smoothingRadius;

// معاملات Clavet
const float restDensity;        // كثافة التوازن (طبيعية، ~10)
const float stiffness;          // صلابة الضغط (k)
const float nearStiffness;      // صلابة الضغط القريب (k_near)
const float viscosityBeta;      // لزوجة تربيعية
const float viscositySigma;     // لزوجة خطية
const float velocityDamping;    // تخميد السرعة (يمتص الدوامة)

const float3 bucketCenter;
const float4 bucketRotation;
const float  bucketRadius;
const float  bucketHeight;
const float  collisionDamping;
const float  wallRestitution;   // معامل ارتداد الجدار (0=بلا ارتداد، صغير=تخميد)
const uint   useBoxShape;       // 0 = سطل أسطواني (افتراضي)، 1 = صندوق مستطيل (حوض اختبار)
const float2 boxHalfSize;       // نصف عرض الصندوق بمحوري X,Z (يُستخدم فقط لو useBoxShape=1)

const float3 externalAccel;

const uint  gridResolution;
const float gridCellSize;
const float3 gridMin;

// ============================================================
//  مساعدات الكواتيرنيون
// ============================================================
float3 QuatRotate(float4 q, float3 v)
{
    float3 u = float3(q.x, q.y, q.z);
    float s = q.w;
    return 2.0 * dot(u, v) * u
         + (s * s - dot(u, u)) * v
         + 2.0 * s * cross(u, v);
}
float4 QuatInverse(float4 q) { return float4(-q.x, -q.y, -q.z, q.w); }

// ============================================================
//  مساعدات الشبكة
// ============================================================
int3 CellCoord(float3 pos)
{
    return (int3)floor((pos - gridMin) / gridCellSize);
}
uint CellHash(int3 c)
{
    c = clamp(c, int3(0,0,0), int3(gridResolution-1, gridResolution-1, gridResolution-1));
    return (uint)(c.x + c.y * gridResolution + c.z * gridResolution * gridResolution);
}

// ============================================================
//  1. الجاذبية + حفظ الموقع السابق + التحريك المبدئي
//     (في صيغة Clavet نحرّك أولاً ثم نصحّح بالكثافة)
// ============================================================
[numthreads(256,1,1)]
void ApplyGravity(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= numParticles) return;

    // الجسيم المستهلك أو المنتظر للرسم (>=2): مخبّأ ومتجمّد
    if (States[id.x] >= 2)
    {
        Velocities[id.x] = float3(0, 0, 0);
        return;
    }

    // القطرات الحرة: جاذبية فقط (لا تتأثر بحركة/قصور السطل)
    // السائل داخل السطل: جاذبية + قصور حركة السطل
    float3 accel = float3(0, -gravity, 0);
    if (States[id.x] == 0)
        accel += externalAccel;

    Velocities[id.x] += accel * deltaTime;

    // احفظ الموقع الحالي ثم حرّك بالسرعة (predict)
    PrevPositions[id.x] = Positions[id.x];
    Positions[id.x] += Velocities[id.x] * deltaTime;
}

// ============================================================
//  2. التجزئة المكانية (counting sort)
// ============================================================
[numthreads(256,1,1)]
void ClearGrid(uint3 id : SV_DispatchThreadID)
{
    uint numCells = gridResolution * gridResolution * gridResolution;
    if (id.x >= numCells) return;
    CellCounts[id.x] = 0;
}

[numthreads(256,1,1)]
void CountParticles(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= numParticles) return;
    uint cell = CellHash(CellCoord(Positions[id.x]));
    ParticleCellIndex[id.x] = cell;
    InterlockedAdd(CellCounts[cell], 1);
}

// ============================================================
//  PrefixSum متوازي على كتل (بدل الخيط الواحد البطيء)
//  المرحلة 1: كل كتلة تحسب prefix sum محلي في الذاكرة المشتركة
//  المرحلة 2: prefix sum على مجاميع الكتل (عدد صغير)
//  المرحلة 3: كل خلية تضيف مجموع الكتل السابقة
// ============================================================
#define SCAN_BLOCK 256
groupshared uint gTemp[SCAN_BLOCK];

// المرحلة 1: prefix sum محلي لكل كتلة + حفظ مجموع الكتلة
[numthreads(SCAN_BLOCK,1,1)]
void PrefixScanBlocks(uint3 id : SV_DispatchThreadID, uint3 gid : SV_GroupID, uint3 tid : SV_GroupThreadID)
{
    uint numCells = gridResolution * gridResolution * gridResolution;
    uint globalIdx = id.x;
    uint local = tid.x;

    // حمّل القيمة (0 لو خارج الحدود)
    uint val = (globalIdx < numCells) ? CellCounts[globalIdx] : 0;
    gTemp[local] = val;
    GroupMemoryBarrierWithGroupSync();

    // prefix sum شامل (inclusive) داخل الكتلة (Hillis-Steele)
    [unroll]
    for (uint offset = 1; offset < SCAN_BLOCK; offset <<= 1)
    {
        uint add = (local >= offset) ? gTemp[local - offset] : 0;
        GroupMemoryBarrierWithGroupSync();
        gTemp[local] += add;
        GroupMemoryBarrierWithGroupSync();
    }

    if (globalIdx < numCells)
    {
        // exclusive prefix = inclusive - القيمة الأصلية
        uint inclusive = gTemp[local];
        uint exclusive = inclusive - val;
        CellStart[globalIdx] = exclusive;   // مؤقت: prefix محلي
        CellEnd[globalIdx] = inclusive;     // مؤقت: inclusive محلي
    }

    // آخر thread في الكتلة يحفظ مجموع الكتلة
    if (local == SCAN_BLOCK - 1)
        BlockSums[gid.x] = gTemp[local];
}

// المرحلة 2: prefix sum على مجاميع الكتل (خيط واحد، لكن عدد الكتل صغير جداً)
[numthreads(1,1,1)]
void PrefixScanBlockSums(uint3 id : SV_DispatchThreadID)
{
    uint numCells = gridResolution * gridResolution * gridResolution;
    uint numBlocks = (numCells + SCAN_BLOCK - 1) / SCAN_BLOCK;
    uint sum = 0;
    for (uint b = 0; b < numBlocks; b++)
    {
        uint bs = BlockSums[b];
        BlockSums[b] = sum;   // exclusive
        sum += bs;
    }
}

// المرحلة 3: كل خلية تضيف مجموع الكتل السابقة + تجهيز CellCounts للـ Scatter
[numthreads(SCAN_BLOCK,1,1)]
void PrefixScanCombine(uint3 id : SV_DispatchThreadID, uint3 gid : SV_GroupID)
{
    uint numCells = gridResolution * gridResolution * gridResolution;
    if (id.x >= numCells) return;
    uint blockOffset = BlockSums[gid.x];
    uint start = CellStart[id.x] + blockOffset;
    uint end = CellEnd[id.x] + blockOffset;
    CellStart[id.x] = start;
    CellEnd[id.x] = end;
    CellCounts[id.x] = start;   // الـ Scatter يزيد من هنا
}

[numthreads(256,1,1)]
void ScatterParticles(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= numParticles) return;
    uint cell = ParticleCellIndex[id.x];
    uint dst;
    InterlockedAdd(CellCounts[cell], 1, dst);
    SortedIndices[dst] = id.x;
}

// إعادة ترتيب بيانات الجسيمات حسب الخلية (الجيران يصيروا متجاورين بالذاكرة)
// مقسّمة لكرنِلين بسبب حد DirectX: أقصى 8 UAV (buffers قابلة للكتابة) لكل kernel

[numthreads(256,1,1)]
void ReorderData_PosVel(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= numParticles) return;
    uint src = SortedIndices[id.x];
    SortedPositions[id.x]     = Positions[src];
    SortedPrevPositions[id.x] = PrevPositions[src];
    SortedVelocities[id.x]    = Velocities[src];
}

[numthreads(256,1,1)]
void ReorderData_StateColor(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= numParticles) return;
    uint src = SortedIndices[id.x];
    SortedStates[id.x]         = States[src];
    ParticleColorsSorted[id.x] = ParticleColorsIn[src];
}

// نسخ البيانات المرتّبة للـ buffers الأصلية (بعدها الجسيمات مرتّبة، الجيران متجاورون)
[numthreads(256,1,1)]
void ReorderCopyBack_PosVel(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= numParticles) return;
    Positions[id.x]     = SortedPositions[id.x];
    PrevPositions[id.x] = SortedPrevPositions[id.x];
    Velocities[id.x]    = SortedVelocities[id.x];
}

[numthreads(256,1,1)]
void ReorderCopyBack_StateColor(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= numParticles) return;
    States[id.x]           = SortedStates[id.x];
    ParticleColorsIn[id.x] = ParticleColorsSorted[id.x];
}

// ============================================================
//  3. Double-Density Relaxation (قلب صيغة Clavet)
//     لكل جسيم: احسب الكثافة والكثافة القريبة، ثم الضغطين،
//     ثم أزح الجيران والجسيم نفسه مباشرةً (تصحيح موقع).
// ============================================================
[numthreads(256,1,1)]
void DoubleDensityRelax(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= numParticles) return;
    if (States[id.x] == 1) return;   // القطرات الحرة لا تشارك في ضغط السائل

    float3 pos = Positions[id.x];
    int3 baseCell = CellCoord(pos);
    float h = smoothingRadius;

    float density = 0;
    float nearDensity = 0;

    // --- تمريرة 1: الكثافة ---
    for (int ox = -1; ox <= 1; ox++)
    for (int oy = -1; oy <= 1; oy++)
    for (int oz = -1; oz <= 1; oz++)
    {
        int3 c = baseCell + int3(ox, oy, oz);
        if (any(c < 0) || any(c >= (int)gridResolution)) continue;
        uint cell = CellHash(c);
        uint start = CellStart[cell];
        uint end = CellEnd[cell];

        for (uint k = start; k < end; k++)
        {
            uint j = k;   // بعد Reorder: الجسيم في الموقع k مباشرة (قراءة متتالية)
            if (j == id.x) continue;
            if (States[j] == 1) continue;   // تجاهل القطرات الحرة كجيران
            float3 diff = Positions[j] - pos;
            float r = length(diff);
            if (r < h && r > 0)
            {
                float q = 1.0 - r / h;
                density     += q * q;
                nearDensity += q * q * q;
            }
        }
    }

    // --- الضغطان ---
    float pressure     = stiffness * (density - restDensity);
    float nearPressure = nearStiffness * nearDensity;

    // --- تمريرة 2: الإزاحات ---
    float3 dispSelf = 0;
    for (int ox2 = -1; ox2 <= 1; ox2++)
    for (int oy2 = -1; oy2 <= 1; oy2++)
    for (int oz2 = -1; oz2 <= 1; oz2++)
    {
        int3 c = baseCell + int3(ox2, oy2, oz2);
        if (any(c < 0) || any(c >= (int)gridResolution)) continue;
        uint cell = CellHash(c);
        uint start = CellStart[cell];
        uint end = CellEnd[cell];

        for (uint k = start; k < end; k++)
        {
            uint j = k;   // بعد Reorder: فهرس متتالي مباشر
            if (j == id.x) continue;
            if (States[j] == 1) continue;   // لا إزاحة من/نحو القطرات الحرة
            float3 diff = Positions[j] - pos;
            float r = length(diff);
            if (r < h && r > 0)
            {
                float q = 1.0 - r / h;
                float3 dir = diff / r;
                float mag = (pressure * q + nearPressure * q * q)
                            * deltaTime * deltaTime * 0.5;
                dispSelf -= dir * mag;
            }
        }
    }

    Positions[id.x] = pos + dispSelf;
}

// ============================================================
//  4. حساب السرعة من تغيّر الموقع + حدود السطل
// ============================================================
[numthreads(256,1,1)]
void ComputeVelocity(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= numParticles) return;

    // المستهلكة (2) والمرسومة (4): مخبّأة ومتجمّدة
    // لكن state=3 (وصلت، تنتظر الرسم) تبقى بموقعها ليرسمها PaintOnCanvas
    if (States[id.x] == 2 || States[id.x] == 4)
    {
        Velocities[id.x] = float3(0, 0, 0);
        Positions[id.x] = float3(9999, 9999, 9999);
        return;
    }
    if (States[id.x] == 3)
    {
        // ثابتة على السطح، تنتظر الرسم (لا تتحرك)
        Velocities[id.x] = float3(0, 0, 0);
        return;
    }

    // السرعة = (الموقع الجديد - السابق) / dt  (يلتقط تصحيح الكثافة)
    float3 newPos = Positions[id.x];
    if (deltaTime > 0)
        Velocities[id.x] = (newPos - PrevPositions[id.x]) / deltaTime;

    // تخميد بسيط: يمتص الحركة الزائدة (بما فيها الدوامة المصطنعة)
    Velocities[id.x] *= velocityDamping;

    // القطرات الحرة: فحص وصول اللوحة + تسقط بحرية بلا حدود سطل
    if (States[id.x] == 1)
    {
        // التقط القطرة لو وصلت أو عبرت مستوى اللوحة (تمنع الاختراق)
        // نفحص الموقع الحالي والسابق: لو عبرت المستوى بينهما
        float prevY = PrevPositions[id.x].y;
        bool crossed = (newPos.y <= canvasY) || (prevY > canvasY && newPos.y <= canvasY);
        if (canvasEnabled == 1 && newPos.y <= canvasY)
        {
            float dx = abs(newPos.x - canvasCenter.x);
            float dz = abs(newPos.z - canvasCenter.z);
            if (dx <= canvasHalfSize.x && dz <= canvasHalfSize.y)
            {
                // ثبّت الموقع عند سطح اللوحة بالضبط (نقطة الرسم دقيقة)
                float3 splatPos = float3(newPos.x, canvasY, newPos.z);
                Positions[id.x] = splatPos;
                Velocities[id.x] = float3(0, 0, 0);
                States[id.x] = 3;   // وصلت اللوحة
                // اكتب موقع الرسم الصحيح فوراً (لا يعتمد على readback متأخر)
                SplatPoints.Append(splatPos);
            }
        }
        return;
    }

    // --- حدود السطل (أسطوانة، مفتوحة من الأعلى) ---
    float4 invRot = QuatInverse(bucketRotation);
    float3 local = QuatRotate(invRot, newPos - bucketCenter);
    float3 localVel = QuatRotate(invRot, Velocities[id.x]);

    float bottomY = -bucketHeight * 0.5;
    bool changed = false;

    // القاع فقط (لا سقف — السطل مفتوح من فوق)
    if (local.y < bottomY)
    {
        local.y = bottomY;
        // ارتداد مخمّد: السرعة العمودية تنعكس مضروبة بمعامل صغير (<1)
        localVel.y = abs(localVel.y) * wallRestitution;
        changed = true;
    }
    float2 xz = float2(local.x, local.z);

    if (useBoxShape == 1)
    {
        // --- حدود صندوق مستطيل (حوض اختبار) - نفس القاع والدوران، جدران مستوية بدل دائرة ---
        if (local.x > boxHalfSize.x)
        {
            local.x = boxHalfSize.x;
            if (localVel.x > 0) localVel.x = -localVel.x * wallRestitution;
            changed = true;
        }
        else if (local.x < -boxHalfSize.x)
        {
            local.x = -boxHalfSize.x;
            if (localVel.x < 0) localVel.x = -localVel.x * wallRestitution;
            changed = true;
        }
        if (local.z > boxHalfSize.y)
        {
            local.z = boxHalfSize.y;
            if (localVel.z > 0) localVel.z = -localVel.z * wallRestitution;
            changed = true;
        }
        else if (local.z < -boxHalfSize.y)
        {
            local.z = -boxHalfSize.y;
            if (localVel.z < 0) localVel.z = -localVel.z * wallRestitution;
            changed = true;
        }
    }
    else
    {
        // --- حدود السطل الأسطواني (الافتراضي، كما كان تماماً) ---
        float radial = length(xz);
        if (radial > bucketRadius)
        {
            float2 n = xz / radial;
            local.x = n.x * bucketRadius;
            local.z = n.y * bucketRadius;
            float2 vxz = float2(localVel.x, localVel.z);
            float vn = dot(vxz, n);
            if (vn > 0)
            {
                // أزِل المركّبة المتجهة للخارج وأضف ارتداداً مخمّداً فقط
                // (1 + restitution) حيث restitution صغير => لا تضخيم
                vxz -= n * vn * (1.0 + wallRestitution);
                localVel.x = vxz.x;
                localVel.z = vxz.y;
            }
            changed = true;
        }
    }

    if (changed)
    {
        Positions[id.x]  = bucketCenter + QuatRotate(bucketRotation, local);
        Velocities[id.x] = QuatRotate(bucketRotation, localVel);
    }
}

// ============================================================
//  5. فحص الثقوب: تحويل الجزيئات القريبة من ثقب إلى قطرات حرة
// ============================================================
[numthreads(256,1,1)]
void CheckHoles(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= numParticles) return;
    if (States[id.x] == 1) return;   // أصلاً حرة

    // موقع الجسيم بإحداثيات السطل المحلية
    float4 invRot = QuatInverse(bucketRotation);
    float3 local = QuatRotate(invRot, Positions[id.x] - bucketCenter);

    float topY = bucketHeight * 0.5;

    // (1) خروج من الفوهة العلوية: لو الجسيم تجاوز الحافة العلوية
    //     بهامش بسيط => انسكب => يصير قطرة حرة
    if (local.y > topY + smoothingRadius)
    {
        States[id.x] = 1;
        // يحتفظ بسرعته الحالية (الانسكاب الطبيعي) لكن نتركها كما هي
        return;
    }

    // (2) خروج من الثقوب
    for (uint hi = 0; hi < numHoles; hi++)
    {
        float4 hole = Holes[hi];          // xyz = موقع محلي، w = نصف القطر
        float3 holePos = hole.xyz;
        float holeR = hole.w;

        float d = length(local - holePos);
        if (d < holeR)
        {
            // الجسيم دخل منطقة الثقب => يصير قطرة حرة
            States[id.x] = 1;
            // أعطه سرعة سقوط نظيفة (يتخلّص من سرعة تأرجح السطل الموروثة)
            Velocities[id.x] = float3(0, -0.5, 0);
            return;
        }
    }
}

// ============================================================
//  6. دوامة التصريف: جذب + التفاف حول الثقوب
//     السائل القريب من ثقب ينجذب له ويلتفّ حوله (whirlpool)
// ============================================================
[numthreads(256,1,1)]
void ApplyVortex(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= numParticles) return;
    if (States[id.x] == 1) return;   // القطرات الحرة لا تتأثر

    float4 invRot = QuatInverse(bucketRotation);
    float3 local = QuatRotate(invRot, Positions[id.x] - bucketCenter);
    float3 localVel = QuatRotate(invRot, Velocities[id.x]);

    bool affected = false;

    for (uint hi = 0; hi < numHoles; hi++)
    {
        float4 hole = Holes[hi];
        float3 holePos = hole.xyz;
        float holeR = hole.w;
        float range = holeR * vortexRange;

        float3 toHole = holePos - local;
        float dist = length(toHole);

        if (dist < range && dist > 0.0001)
        {
            // محور الدوامة = اتجاه الثقب من المركز (نورمال الثقب)
            float3 axis = normalize(holePos);
            if (length(holePos) < 0.0001) axis = float3(0, 1, 0);

            float3 radialDir = toHole / dist;          // نحو الثقب
            // عامل القوة: يزداد كلما اقترب (1 عند الثقب، 0 عند الحافة)
            float strength = 1.0 - (dist / range);
            strength = strength * strength;            // تركيز أقوى قرب المركز

            // 1) جذب شعاعي نحو الثقب
            localVel += radialDir * vortexPull * strength * deltaTime;

            // 2) قوة دورانية: عمودية على (المحور، الاتجاه الشعاعي)
            float3 tangent = cross(axis, radialDir);
            localVel += tangent * vortexSpin * strength * deltaTime;

            affected = true;
        }
    }

    if (affected)
        Velocities[id.x] = QuatRotate(bucketRotation, localVel);
}

// ============================================================
//  7. الرسم على اللوحة مباشرة على GPU (صفر تأخير)
//     كل جسيم وصل اللوحة (state=3) يرسم بقعة على التكستشر فوراً
// ============================================================
[numthreads(256,1,1)]
void PaintOnCanvas(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= numParticles) return;
    if (States[id.x] != 3) return;   // فقط القطرات الواصلة الجديدة

    float3 pos = Positions[id.x];
    // لون هذا الجسيم (يدعم ألوان متعددة)
    float4 dropColor = ParticleColors[id.x];

    // حوّل موقع العالم إلى إحداثيات UV على اللوحة [0,1]
    float u = (pos.x - canvasCenter.x) / (canvasHalfSize.x * 2.0) + 0.5;
    float v = (pos.z - canvasCenter.z) / (canvasHalfSize.y * 2.0) + 0.5;

    // RenderTexture في Unity: المحور العمودي (Y بالبكسل) مقلوب
    // نقلب V لمطابقة اتجاه العرض الصحيح
    if (canvasFlipV == 1)
        v = 1.0 - v;
    if (canvasFlipU == 1)
        u = 1.0 - u;

    // خارج اللوحة؟ علّمها مستهلكة وأنهِ
    if (u < 0.0 || u > 1.0 || v < 0.0 || v > 1.0)
    {
        States[id.x] = 4;
        return;
    }

    // مركز البقعة بالبكسل
    int cx = (int)(u * canvasResolution);
    int cy = (int)(v * canvasResolution);
    int r = (int)splatRadiusPixels;
    if (r < 1) r = 1;
    int coreRadius = r;   // حجم القطرة الثابت (المركز)

    // التوسّع: البركة تكبر للخارج مع التراكم، لكن المركز يبقى بحجم القطرة
    // outerRadius = حجم البركة المتوسّعة (تحت)، coreRadius = الطبقة الجديدة (فوق بالنص)
    int outerRadius = coreRadius;
    if (canvasPooling == 1)
    {
        int centerIdx = clamp(cy,0,(int)canvasResolution-1) * (int)canvasResolution
                      + clamp(cx,0,(int)canvasResolution-1);
        CanvasAccum[centerIdx] += 1.0;
        float accum = CanvasAccum[centerIdx];
        // البركة الخارجية تتوسّع لوغاريتمياً مع التراكم
        float growth = log2(1.0 + accum) * poolGrowth;
        outerRadius = (int)(coreRadius * (1.0 + growth));
        uint maxR = canvasResolution / 4u;
        if (outerRadius > (int)maxR) outerRadius = (int)maxR;
    }
    int r_draw = outerRadius;   // نرسم حتى الحد الخارجي

    // ارسم دائرة ناعمة: البركة الخارجية (تحت) + المركز الكامل (فوق)
    for (int dy = -r_draw; dy <= r_draw; dy++)
    {
        for (int dx = -r_draw; dx <= r_draw; dx++)
        {
            int px = cx + dx;
            int py = cy + dy;
            if (px < 0 || px >= (int)canvasResolution) continue;
            if (py < 0 || py >= (int)canvasResolution) continue;

            float fdx = (float)dx;
            float fdy = (float)dy;
            float dist = sqrt(fdx*fdx + fdy*fdy);

            // تلاشي البركة الكاملة (حتى الحد الخارجي)
            float outerFalloff = 1.0 - saturate(dist / (float)r_draw);
            outerFalloff = smoothstep(0.0, 1.0, outerFalloff);
            if (outerFalloff <= 0.001) continue;

            // هل داخل المركز (الطبقة الجديدة بحجم القطرة)؟
            bool inCore = dist <= (float)coreRadius;
            float coreFalloff = 0.0;
            if (inCore)
            {
                coreFalloff = 1.0 - saturate(dist / (float)coreRadius);
                coreFalloff = smoothstep(0.0, 1.0, coreFalloff);
            }

            // البركة الخارجية: شفافية أقل (طبقة رقيقة متوسّعة)
            // المركز: لون كامل (الطبقة الطازجة)
            float alpha;
            if (inCore)
                alpha = (coreFalloff > 0.8) ? coreFalloff : paintOpacityGPU * coreFalloff;
            else
                alpha = paintOpacityGPU * outerFalloff * 0.5;  // البركة أرق

            uint2 coord = uint2((uint)px, (uint)py);
            float4 existing = CanvasTex[coord];

            // هل البكسل فيه دهان مختلف مسبقاً؟ (رطب => خلط)
            float colorDiff = distance(existing.rgb, dropColor.rgb);
            bool hasPaint = existing.a > 0.05;

            float4 result;
            if (hasPaint && colorDiff > 0.1 && canvasWetMix == 1)
            {
                // خلط طرحي واقعي (مثل الدهان)
                float3 subtractive = existing.rgb * dropColor.rgb;
                float3 average = (existing.rgb + dropColor.rgb) * 0.5;
                float3 mixed = lerp(average, subtractive, wetMixStrength);
                result.rgb = lerp(existing.rgb, mixed, alpha);
                result.a = max(existing.a, alpha);
            }
            else
            {
                // نفس اللون أو بكسل فارغ => طبقة عادية
                result = lerp(existing, dropColor, alpha);
                result.a = max(existing.a, alpha);
            }
            CanvasTex[coord] = result;
        }
    }

    States[id.x] = 4;   // مستهلكة نهائياً
}
